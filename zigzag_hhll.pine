//@version=6
indicator("ZigZag HHLL + Leg Stats", shorttitle="ZZ-HHLL Stats", overlay=true, max_labels_count=500, max_lines_count=500)

// ============================================================
// 输入参数 Inputs
// ============================================================
grpZ = "ZigZag"
prd        = input.int(10, "ZigZag period", minval=2, group=grpZ, tooltip="当前K线是最近N根里的最高/最低时才会触发方向切换")
srcType    = input.string("High/Low", "Source", options=["High/Low", "Close/Open"], group=grpZ)
zzUpCol    = input.color(#00E676, "Zigzag up color", group=grpZ)
zzDnCol    = input.color(#FF5252, "Zigzag down color", group=grpZ)
showZZ     = input.bool(true, "Show zigzag lines", group=grpZ)
showLabels = input.bool(true, "Show HH / LL labels", group=grpZ)
maxPts     = input.int(52, "Max swings shown", minval=1, maxval=499, group=grpZ, tooltip="只显示最近N个已确认的摆动点（原版约为52个）。同时决定左上角统计表的统计范围")
showLive   = input.bool(true, "Show live (last) leg", group=grpZ)
markLive   = input.bool(false, "Mark live leg as unconfirmed (dashed + ?)", group=grpZ, tooltip="最后一段尚未确认，会随价格移动。打开后用虚线和问号区分")

grpO = "OB/OS Label Highlight"
hlOBOS   = input.bool(true, "Change color in OB/OS levels", group=grpO, tooltip="摆动点那根K线上，RSI(14) 和 Stoch RSI 的 %D (3,3,14,14) 同时进入超买/超卖区时，标签变成醒目方框")
obLvl    = input.float(65, "Overbought level", group=grpO)
osLvl    = input.float(35, "Oversold level", group=grpO)
obBoxCol = input.color(#FF525280, "Overbought label color", group=grpO)
osBoxCol = input.color(#00E67680, "Oversold label color", group=grpO)

grpL = "Leg Duration Stats"
showStats = input.bool(true, "Show leg duration table", group=grpL, tooltip="统计当前图表周期下、显示范围内每段走势持续的K线数量（从一个摆动点到下一个摆动点）")
statsPos  = input.string("Top left", "Table position", options=["Top left", "Middle left", "Bottom left"], group=grpL)

// ============================================================
// OB/OS 判定（用于方框标签，固定参数，和原版一致）
// RSI(14) 与 Stoch RSI %D 同时超买/超卖
// ============================================================
obRsi  = ta.rsi(close, 14)
obSrsD = ta.sma(ta.sma(ta.stoch(obRsi, obRsi, obRsi, 14), 3), 3)
isOB = obRsi >= obLvl and obSrsD >= obLvl
isOS = obRsi <= osLvl and obSrsD <= osLvl

// ============================================================
// 标签与显示管理
// 高点：2 = HH, 1 = High (New High), -1 = LH
// 低点：2 = LL, 1 = Low (New Low),  -1 = HL
// ============================================================
var array<line>  zzLines  = array.new<line>()
var array<label> zzLabels = array.new<label>()

f_text(bool isHigh, int lbl) =>
    isHigh ? (lbl == 2 ? "HH" : lbl == 1 ? "High" : "LH") : (lbl == 2 ? "LL" : lbl == 1 ? "Low" : "HL")

f_draw(int x, float y, bool isHigh, int lbl, bool hot, string suffix) =>
    color bg = hot ? (isHigh ? obBoxCol : osBoxCol) : color.new(color.white, 100)
    color tc = hot ? color.white : (isHigh ? zzUpCol : zzDnCol)
    label.new(x, y, f_text(isHigh, lbl) + suffix, style=isHigh ? label.style_label_down : label.style_label_up,
         color=bg, textcolor=tc, size=size.normal)

f_keepLabel(label lb) =>
    array.push(zzLabels, lb)
    if array.size(zzLabels) > maxPts
        label.delete(array.shift(zzLabels))

f_keepLine(line ln) =>
    array.push(zzLines, ln)
    if array.size(zzLines) > maxPts
        line.delete(array.shift(zzLines))

// 每段走势的持续K线数和方向（1 = 上涨段, -1 = 下跌段），只保留显示范围内的
var array<int> legLen = array.new<int>()
var array<int> legDir = array.new<int>()

f_keepLeg(int len, int dr) =>
    array.push(legLen, len)
    array.push(legDir, dr)
    if array.size(legLen) > maxPts
        array.shift(legLen)
        array.shift(legDir)

// ============================================================
// ZigZag 结构
// ============================================================
hiSrc = srcType == "High/Low" ? high : math.max(open, close)
loSrc = srcType == "High/Low" ? low  : math.min(open, close)
isHi = ta.highestbars(hiSrc, prd) == 0
isLo = ta.lowestbars(loSrc, prd) == 0

var int   dir       = 0
var float tentHi    = na
var int   tentHiBar = na
var bool  tentHiOB  = false
var float tentLo    = na
var int   tentLoBar = na
var bool  tentLoOS  = false

var float lastHigh    = na
var float lastLow     = na
var int   lastPtBar   = na
var float lastPtPrice = na
var int   prevHiLbl   = 0
var int   prevLoLbl   = 0

bool aNewHigh = false
bool aHH      = false
bool aLH      = false
bool aNewLow  = false
bool aLL      = false
bool aHL      = false

int prevDir = dir
if isHi and not isLo
    dir := 1
else if isLo and not isHi
    dir := -1

// 下跌段结束 → 确认低点
// LL 只在“上一个低点是 Low/LL，且中间的高点是 LH”时成立，否则跌破前低记为 Low
if dir == 1 and prevDir == -1
    if not na(lastLow)
        int lbl = tentLo < lastLow ? (prevLoLbl >= 1 and prevHiLbl == -1 ? 2 : 1) : -1
        prevLoLbl := lbl
        aNewLow := lbl == 1
        aLL     := lbl == 2
        aHL     := lbl == -1
        if showLabels
            f_keepLabel(f_draw(tentLoBar, tentLo, false, lbl, hlOBOS and tentLoOS, ""))
    if not na(lastPtBar)
        f_keepLeg(tentLoBar - lastPtBar, -1)
    if showZZ and not na(lastPtBar)
        f_keepLine(line.new(lastPtBar, lastPtPrice, tentLoBar, tentLo, color=zzDnCol, width=2))
    lastLow     := tentLo
    lastPtBar   := tentLoBar
    lastPtPrice := tentLo

// 上涨段结束 → 确认高点
// HH 只在“上一个高点是 High/HH，且中间的低点是 HL”时成立，否则突破前高记为 High
if dir == -1 and prevDir == 1
    if not na(lastHigh)
        int lbl = tentHi > lastHigh ? (prevHiLbl >= 1 and prevLoLbl == -1 ? 2 : 1) : -1
        prevHiLbl := lbl
        aNewHigh := lbl == 1
        aHH      := lbl == 2
        aLH      := lbl == -1
        if showLabels
            f_keepLabel(f_draw(tentHiBar, tentHi, true, lbl, hlOBOS and tentHiOB, ""))
    if not na(lastPtBar)
        f_keepLeg(tentHiBar - lastPtBar, 1)
    if showZZ and not na(lastPtBar)
        f_keepLine(line.new(lastPtBar, lastPtPrice, tentHiBar, tentHi, color=zzUpCol, width=2))
    lastHigh    := tentHi
    lastPtBar   := tentHiBar
    lastPtPrice := tentHi

// 追踪当前段的极值，并记录该K线的 OB/OS 状态
if dir == 1
    if prevDir != 1 or hiSrc > tentHi
        tentHi    := hiSrc
        tentHiBar := bar_index
        tentHiOB  := isOB
if dir == -1
    if prevDir != -1 or loSrc < tentLo
        tentLo    := loSrc
        tentLoBar := bar_index
        tentLoOS  := isOS

// ============================================================
// 最后一段（未确认）
// ============================================================
var line  liveLine  = na
var label liveLabel = na
if barstate.islast
    line.delete(liveLine)
    label.delete(liveLabel)
    if showLive and not na(lastPtBar)
        bool  isH    = dir == 1
        float tPrice = isH ? tentHi : tentLo
        int   tBar   = isH ? tentHiBar : tentLoBar
        if not na(tPrice)
            if showZZ
                liveLine := line.new(lastPtBar, lastPtPrice, tBar, tPrice, color=isH ? zzUpCol : zzDnCol, width=2,
                     style=markLive ? line.style_dashed : line.style_solid)
            float refPx = isH ? lastHigh : lastLow
            if showLabels and not na(refPx)
                int  lbl = isH ? (tPrice > refPx ? (prevHiLbl >= 1 and prevLoLbl == -1 ? 2 : 1) : -1) : (tPrice < refPx ? (prevLoLbl >= 1 and prevHiLbl == -1 ? 2 : 1) : -1)
                bool hot = hlOBOS and (isH ? tentHiOB : tentLoOS)
                liveLabel := f_draw(tBar, tPrice, isH, lbl, hot, markLive ? "?" : "")

// ============================================================
// 左上角：走势持续K线数统计
// ============================================================
var table stats = table.new(statsPos == "Top left" ? position.top_left : statsPos == "Middle left" ? position.middle_left : position.bottom_left, 4, 3, bgcolor=color.new(color.black, 25), border_width=1)
if barstate.islast and showStats
    int upMax = 0
    int upSum = 0
    int upN   = 0
    int dnMax = 0
    int dnSum = 0
    int dnN   = 0
    if array.size(legLen) > 0
        for i = 0 to array.size(legLen) - 1
            int ln = array.get(legLen, i)
            if array.get(legDir, i) == 1
                upMax := math.max(upMax, ln)
                upSum += ln
                upN   += 1
            else
                dnMax := math.max(dnMax, ln)
                dnSum += ln
                dnN   += 1
    float upAvg  = upN > 0 ? upSum * 1.0 / upN : na
    float dnAvg  = dnN > 0 ? dnSum * 1.0 / dnN : na
    // 当前段：从上一个确认摆动点到最后一段的极值点（即最新标签所在K线），和历史段口径一致
    int   liveBar = dir == 1 ? tentHiBar : tentLoBar
    int   curLen  = na(lastPtBar) or na(liveBar) ? na : liveBar - lastPtBar

    // 当前段超过平均值变黄，超过历史最大值变橙
    color upCurCol = curLen > upMax ? color.orange : curLen > upAvg ? color.yellow : color.white
    color dnCurCol = curLen > dnMax ? color.orange : curLen > dnAvg ? color.yellow : color.white

    table.cell(stats, 0, 0, "Leg (" + timeframe.period + ")", text_color=color.white, text_size=size.small)
    table.cell(stats, 1, 0, "Max", text_color=color.white, text_size=size.small)
    table.cell(stats, 2, 0, "Avg", text_color=color.white, text_size=size.small)
    table.cell(stats, 3, 0, "Current", text_color=color.white, text_size=size.small)

    table.cell(stats, 0, 1, "Up", text_color=zzUpCol, text_size=size.small)
    table.cell(stats, 1, 1, upN > 0 ? str.tostring(upMax) : "-", text_color=color.white, text_size=size.small)
    table.cell(stats, 2, 1, upN > 0 ? str.tostring(upAvg, "#.0") : "-", text_color=color.white, text_size=size.small)
    table.cell(stats, 3, 1, dir == 1 and not na(curLen) ? str.tostring(curLen) : "-", text_color=dir == 1 ? upCurCol : color.gray, text_size=size.small)

    table.cell(stats, 0, 2, "Down", text_color=zzDnCol, text_size=size.small)
    table.cell(stats, 1, 2, dnN > 0 ? str.tostring(dnMax) : "-", text_color=color.white, text_size=size.small)
    table.cell(stats, 2, 2, dnN > 0 ? str.tostring(dnAvg, "#.0") : "-", text_color=color.white, text_size=size.small)
    table.cell(stats, 3, 2, dir == -1 and not na(curLen) ? str.tostring(curLen) : "-", text_color=dir == -1 ? dnCurCol : color.gray, text_size=size.small)

// ============================================================
// 警报 Alerts（在摆动点被确认时触发）
// ============================================================
alertcondition(aNewHigh, "New High",     "New High confirmed")
alertcondition(aHH,      "Higher High",  "Higher High confirmed")
alertcondition(aLH,      "Lower High",   "Lower High confirmed")
alertcondition(aNewLow,  "New Low",      "New Low confirmed")
alertcondition(aLL,      "Lower Low",    "Lower Low confirmed")
alertcondition(aHL,      "Higher Low",   "Higher Low confirmed")
